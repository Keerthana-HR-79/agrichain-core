# ============================================================
# AgriChain Frontend (Vite) — environment template
# Copy to .env and adjust:  cp .env.example .env
# Only VITE_-prefixed vars are exposed to the browser — never put
# secrets here.
# ============================================================

# Base origin of the backend server — the app appends "/api" itself.
# So set the ORIGIN only (no trailing /api, no trailing slash).
VITE_API_URL=http://localhost:5000
