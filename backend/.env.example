# ============================================================
# AgriChain Backend — environment template
# Copy to .env and fill in real values:  cp .env.example .env
#
# ⚠️  NEVER commit the real .env. Only this .env.example (with
#     placeholders) is tracked in git. In production, set these
#     in your host's dashboard (Render), NOT in a committed file.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
# Local dev: your pgAdmin/localhost values.
# Production (Supabase): use the SESSION-MODE POOLER connection
#   (Supabase → Project Settings → Database → Connection pooling
#    → "Session" mode). Do NOT use Transaction mode (port 6543):
#   escrow relies on advisory locks + SERIALIZABLE transactions
#   that need a stable session.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrichain-ai
DB_USER=postgres
DB_PASSWORD=your-db-password
# Set to "true" for Supabase/Neon/any hosted Postgres (requires SSL).
DB_SSL=false

# ── Supabase Storage (image uploads: listings, crop stages, profiles) ─
# From Supabase → Project Settings → API.
# SUPABASE_SERVICE_KEY is the service_role key — full admin, keep secret.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Auth ─────────────────────────────────────────────────────
# Long random string. In production, let Render generate one.
JWT_SECRET=your-long-random-jwt-secret

# ── AI microservice (FastAPI yield/climate engine) ───────────
# Base ORIGIN only (no trailing path). The backend appends
# /predict, /predict/dynamic, /climate/... itself.
# Local: http://127.0.0.1:8000   Prod: your deployed AI service URL.
AI_SERVICE_URL=http://127.0.0.1:8000

# ── Frontend origin (CORS) ───────────────────────────────────
# Local: http://localhost:3000   Prod: your Vercel URL.
FRONTEND_URL=http://localhost:3000

# ── Groq LLM (chatbot + negotiation agent) ───────────────────
GROQ_API_KEY=your-groq-api-key
# Optional — defaults to openai/gpt-oss-20b if unset.
GROQ_MODEL=openai/gpt-oss-20b

# ── Email (verification / OTP via SendGrid HTTPS API) ────────
# Render's free tier blocks outbound SMTP (ports 25/465/587), so OTP mail
# goes through SendGrid's HTTPS API instead of Gmail SMTP.
#   1. sendgrid.com → Sender Authentication → verify a Single Sender using
#      EMAIL_USER below (no custom domain needed).
#   2. Settings → API Keys → create a key with the "Mail Send" permission
#      (it starts with "SG."). Set it in Render's dashboard, never in git.
# EMAIL_USER doubles as the verified "From" address on every OTP email.
EMAIL_USER=you@example.com
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# ── Market prices (data.gov.in) ──────────────────────────────
# Optional. Register a free key at data.gov.in for reliable live
# prices; without it the app uses a shared, rate-limited sample key.
DATA_GOV_API_KEY=your-data-gov-key

# ── Server port ──────────────────────────────────────────────
# Local only. On Render this is provided automatically — do NOT set it.
PORT=5000
